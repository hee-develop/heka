#!/bin/bash
# pre-push 훅: 푸시될 커밋에 금지어나 비밀키가 있으면 푸시를 막는다.
# 공개 저장소용이므로 오류가 나면 통과시키지 않고 막는다(종료 코드 1).
#
# 사용법
#   (git 이 호출)                  인자 $1=원격 이름, 표준 입력으로 "<local ref> <local sha> <remote ref> <remote sha>" 줄들
#   .githooks/pre-push --all       HEAD 에서 닿는 모든 커밋을 검사한다
#   .githooks/pre-push --range R   rev 범위 R(예: main..HEAD)의 커밋을 검사한다
#
# 검사 대상(커밋마다): 작성자·커미터 이름과 이메일, 커밋 메시지, 바뀐 파일 경로,
#   diff 에서 추가된 줄. 삭제된 줄은 검사하지 않는다.
#
# 금지어 목록: 환경 변수 HEKA_PUSH_DENYLIST 가 가리키는 파일, 없으면
#   $HOME/.config/heka/push-denylist.txt. 한 줄에 확장 정규식 하나,
#   빈 줄과 '#' 으로 시작하는 줄은 무시, 대소문자 구분 없이 대조한다.
#   파일이 없으면 푸시를 막는다. HEKA_PUSH_DENYLIST_OPTIONAL=1 이면
#   금지어 검사만 건너뛰고 비밀키 검사는 한다.
#
# 비밀키 패턴은 아래에 내장돼 있다. 이 파일 자신이 걸리지 않도록
# 각 패턴은 자기 자신과 일치하지 않는 꼴로 적었다.

set -u

ZERO='^0+$'
TMP="$(mktemp -d "${TMPDIR:-/tmp}/heka-pre-push.XXXXXX")" || {
  echo "pre-push: 임시 디렉터리를 만들지 못했다. 푸시를 막았다." >&2
  exit 1
}
trap 'rm -rf "$TMP"' EXIT

fail_internal() {
  echo "pre-push: 내부 오류: $1" >&2
  echo "pre-push: 검사를 끝내지 못했으므로 푸시를 막았다." >&2
  exit 1
}

# ---- 비밀키 패턴(대소문자 구분) ----
SECRETS="$TMP/secrets.txt"
{
  echo '-----BEGIN ([A-Z]+ )*PRIVATE KEY'
  echo 'xox[abposr]-[0-9A-Za-z-]{10,}'
  echo 'gh[pousr]_[0-9A-Za-z]{30,}'
  echo 'github_pat_[0-9A-Za-z_]{20,}'
  echo 'sk-ant-[0-9A-Za-z_-]{10,}'
  echo 'AKIA[0-9A-Z]{16}'
  echo 'AIza[0-9A-Za-z_-]{35}'
} > "$SECRETS" || fail_internal "비밀키 패턴 파일을 쓰지 못했다"

# ---- 금지어 목록 읽기 ----
DENY_FILE="${HEKA_PUSH_DENYLIST:-$HOME/.config/heka/push-denylist.txt}"
PATS="$TMP/deny.txt"
HAVE_DENY=0
if [ -f "$DENY_FILE" ]; then
  tr -d '\r' < "$DENY_FILE" | grep -Ev '^[[:space:]]*(#|$)' > "$PATS"
  rc=$?
  if [ "$rc" -gt 1 ]; then
    fail_internal "금지어 목록을 읽지 못했다"
  fi
  if [ -s "$PATS" ]; then
    # 정규식이 올바른지 미리 확인한다(잘못된 줄이 있으면 grep 이 2 를 돌려준다)
    grep -Eif "$PATS" /dev/null
    rc=$?
    if [ "$rc" -gt 1 ]; then
      fail_internal "금지어 목록에 잘못된 정규식이 있다(패턴은 출력하지 않는다)"
    fi
    HAVE_DENY=1
  fi
elif [ "${HEKA_PUSH_DENYLIST_OPTIONAL:-}" = "1" ]; then
  echo "pre-push: 금지어 목록이 없어 금지어 검사를 건너뛴다(비밀키 검사는 한다)." >&2
else
  {
    echo "pre-push: 금지어 목록 파일이 없다. 푸시를 막았다."
    echo "  경로: $DENY_FILE"
    echo "  만드는 방법: 한 줄에 확장 정규식 하나를 적은 텍스트 파일을 위 경로에 만든다."
    echo "    mkdir -p \"\$HOME/.config/heka\" && \$EDITOR \"\$HOME/.config/heka/push-denylist.txt\""
    echo "  다른 경로를 쓰려면 환경 변수 HEKA_PUSH_DENYLIST 에 파일 경로를 지정한다."
    echo "  금지어 검사만 건너뛰려면 HEKA_PUSH_DENYLIST_OPTIONAL=1 (비밀키 검사는 계속한다)."
  } >&2
  exit 1
fi

# ---- 검사할 커밋 목록 만들기 ----
COMMITS="$TMP/commits.txt"
: > "$COMMITS"

add_revs() { # 인자: git rev-list 인자들
  git rev-list "$@" >> "$COMMITS" 2> "$TMP/err.txt" || {
    fail_internal "git rev-list $* 실패: $(head -c 200 "$TMP/err.txt")"
  }
}

case "${1:-}" in
  --all)
    if git rev-parse --verify -q HEAD > /dev/null 2>&1; then
      add_revs HEAD
    fi
    ;;
  --range)
    [ -n "${2:-}" ] || fail_internal "--range 에는 rev 범위가 필요하다"
    add_revs "$2"
    ;;
  *)
    remote="${1:-}"
    while read -r lref lsha rref rsha; do
      [ -n "${lsha:-}" ] || continue
      if echo "$lsha" | grep -Eq "$ZERO"; then
        continue # 삭제 푸시
      fi
      if echo "$rsha" | grep -Eq "$ZERO"; then
        add_revs "$lsha" --not "--remotes=$remote"
      else
        add_revs "$rsha..$lsha"
      fi
    done
    ;;
esac

# 중복 제거(순서 유지)
awk '!seen[$0]++' "$COMMITS" > "$TMP/commits.uniq" || fail_internal "커밋 목록 정리 실패"
mv "$TMP/commits.uniq" "$COMMITS" || fail_internal "커밋 목록 정리 실패"
NCOMMITS="$(wc -l < "$COMMITS" | tr -d ' ')"

if [ "$NCOMMITS" -eq 0 ]; then
  echo "pre-push: 검사할 커밋 없음"
  exit 0
fi

# ---- 검사 ----
FOUND=0

# scan_file <파일> <커밋 해시> <위치 이름>
scan_file() {
  local file="$1" short="$2" where="$3" out="$TMP/hits.txt" rc line
  if [ "$HAVE_DENY" -eq 1 ]; then
    grep -aEif "$PATS" "$file" > "$out"
    rc=$?
    if [ "$rc" -gt 1 ]; then fail_internal "금지어 대조 실패"; fi
    if [ "$rc" -eq 0 ]; then
      while IFS= read -r line; do
        FOUND=$((FOUND + 1))
        printf '[%s] 금지어(%s): %s\n' "$short" "$where" "$(printf '%s' "$line" | cut -c1-160)" >&2
      done < "$out"
    fi
  fi
  grep -aEf "$SECRETS" "$file" > "$out"
  rc=$?
  if [ "$rc" -gt 1 ]; then fail_internal "비밀키 대조 실패"; fi
  if [ "$rc" -eq 0 ]; then
    while IFS= read -r line; do
      FOUND=$((FOUND + 1))
      printf '[%s] 비밀키(%s): %s\n' "$short" "$where" "$(printf '%s' "$line" | cut -c1-160)" >&2
    done < "$out"
  fi
}

while IFS= read -r sha; do
  short="$(git rev-parse --short "$sha" 2> /dev/null)" || fail_internal "git rev-parse $sha 실패"

  # 작성자·커미터와 커밋 메시지
  git log -1 --format='%an <%ae>%n%cn <%ce>' "$sha" > "$TMP/ident.txt" || fail_internal "git log 실패($short)"
  scan_file "$TMP/ident.txt" "$short" "작성자·커미터"
  git log -1 --format='%B' "$sha" > "$TMP/msg.txt" || fail_internal "git log 실패($short)"
  scan_file "$TMP/msg.txt" "$short" "커밋 메시지"

  # 바뀐 파일 경로
  git -c core.quotepath=off diff-tree -m -r --root --no-commit-id --name-only "$sha" > "$TMP/paths.txt" ||
    fail_internal "git diff-tree 실패($short)"
  scan_file "$TMP/paths.txt" "$short" "파일 경로"

  # diff 에서 추가된 줄('+' 로 시작, 파일 헤더 제외)
  git -c core.quotepath=off diff-tree -m -p -U0 --root --no-commit-id --no-color --no-ext-diff "$sha" > "$TMP/diff.txt" ||
    fail_internal "git diff-tree -p 실패($short)"
  awk '
    /^diff --git / { hdr = 1; next }
    /^@@ /         { hdr = 0; next }
    hdr            { next }
    /^\+/          { print substr($0, 2) }
  ' "$TMP/diff.txt" > "$TMP/added.txt" || fail_internal "diff 해석 실패($short)"
  scan_file "$TMP/added.txt" "$short" "추가된 줄"
done < "$COMMITS"

if [ "$FOUND" -gt 0 ]; then
  echo "pre-push: 금지어·비밀키 ${FOUND}건 발견(커밋 ${NCOMMITS}개 검사). 푸시를 막았다." >&2
  exit 1
fi

echo "pre-push: 커밋 ${NCOMMITS}개 검사, 문제 없음"
exit 0
