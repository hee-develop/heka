#!/bin/bash
# pre-push 훅: 푸시될 커밋에 금지어나 비밀키가 있으면 푸시를 막는다.
# 공개 저장소용이므로 오류가 나면 통과시키지 않고 막는다(종료 코드 1).
# 사람에게 묻지 않는다. 걸린 것이 있거나 내부 오류일 때만 막고, 그 밖에는 조용히 지나간다.
#
# 사용법
#   (git 이 호출)                  인자 $1=원격 이름, 표준 입력으로 "<local ref> <local sha> <remote ref> <remote sha>" 줄들
#   .githooks/pre-push --all       로컬의 모든 브랜치·태그·원격 추적 ref(와 HEAD)에서 닿는 커밋을 검사한다
#   .githooks/pre-push --range R   rev 범위 R(예: main..HEAD)의 커밋을 검사한다
#   모르는 '-' 인자(--range=main 같은 오타 포함)는 사용법을 내고 종료 코드 2 로 끝난다.
#
# 검사 대상
#   커밋마다: 작성자·커미터 이름과 이메일, 커밋 메시지(트레일러 포함), 병합 커밋에 든 태그(mergetag),
#     바뀐 파일 경로, diff 에서 추가된 줄. 바이너리로 판정된 파일도 내용을 검사한다. 삭제된 줄은 검사하지 않는다.
#   푸시되는 주석 태그: 태그 메시지와 태거 이름·이메일(--all 이면 모든 주석 태그).
#   푸시되는 ref 이름: 로컬·원격 양쪽, 브랜치와 태그(--all 이면 모든 로컬 ref 이름).
#
# 출력: 걸린 줄의 원문과 금지어 패턴은 출력하지 않는다. 어느 커밋의 어디(파일·메시지·작성자·ref)인지와
#   걸린 종류(금지어 / 비밀키 종류)만 알린다.
#
# 금지어 목록: 환경 변수 HEKA_PUSH_DENYLIST 가 가리키는 파일, 없으면
#   $HOME/.config/heka/push-denylist.txt. 한 줄에 확장 정규식 하나,
#   앞뒤 공백은 지우고, 빈 줄과 '#' 으로 시작하는 줄은 무시, 대소문자 구분 없이 대조한다.
#   목록을 읽을 수 없거나, 유효한 패턴이 하나도 없거나, 파일이 없으면 푸시를 막는다.
#   파일이 없거나 패턴이 하나도 없을 때 HEKA_PUSH_DENYLIST_OPTIONAL=1 이면
#   경고를 내고 비밀키 검사만으로 진행한다(읽을 수 없는 목록은 이 설정으로도 막는다).
#
# 비밀키 패턴은 아래에 내장돼 있다. 이 파일 자신이 걸리지 않도록
# 각 패턴은 자기 자신과 일치하지 않는 꼴로 적었다.

set -u

usage() {
  cat >&2 << 'EOF'
사용법:
  pre-push <원격 이름> [<URL>]    (git 이 호출. 표준 입력으로 푸시할 ref 줄들을 받는다)
  pre-push --all                  로컬의 모든 브랜치·태그·원격 추적 ref 에서 닿는 커밋을 검사한다
  pre-push --range <rev 범위>     예: --range origin/main..main
EOF
}

usage_err() {
  echo "pre-push: $1" >&2
  usage
  exit 2
}

# ---- 인자 ----
MODE=push
REMOTE=""
RANGE=""
case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  --all) MODE=all ;;
  --range)
    [ -n "${2:-}" ] || usage_err "--range 에는 rev 범위가 필요하다"
    case "$2" in -*) usage_err "--range 의 값이 '-' 로 시작한다" ;; esac
    MODE=range
    RANGE="$2"
    ;;
  -*) usage_err "알 수 없는 인자: $1" ;;
  *) REMOTE="${1:-}" ;;
esac

ZERO='^0+$'
TMP="$(mktemp -d "${TMPDIR:-/tmp}/heka-pre-push.XXXXXX")" || {
  echo "pre-push: 임시 디렉터리를 만들지 못했다. 푸시를 막았다." >&2
  exit 1
}
trap 'rm -rf "$TMP"' EXIT

fail_internal() {
  echo "pre-push: 내부 오류: $1" >&2
  echo "pre-push: 검사를 끝내지 못했으므로 푸시를 막았다." >&2
  exit 1
}

# ---- 비밀키 패턴(대소문자 구분) ----
# sec <이름> <확장 정규식>: 패턴 파일과 이름 파일에 같은 순서로 한 줄씩 적는다.
SECRETS="$TMP/secrets.txt"
SECLABELS="$TMP/seclabels.txt"
: > "$SECRETS" || fail_internal "비밀키 패턴 파일을 쓰지 못했다"
: > "$SECLABELS" || fail_internal "비밀키 패턴 파일을 쓰지 못했다"
sec() {
  echo "$2" >> "$SECRETS" && echo "$1" >> "$SECLABELS" || fail_internal "비밀키 패턴 파일을 쓰지 못했다"
}
sec 'PEM 개인키' '-----BEGIN ([A-Z]+ )*PRIVATE KEY'
sec 'Slack 토큰' 'xox[abposr]-[0-9A-Za-z-]{10,}'
sec 'GitHub 토큰' 'gh[pousr]_[0-9A-Za-z]{30,}'
sec 'GitHub 세분화 토큰' 'github_pat_[0-9A-Za-z_]{20,}'
sec 'Anthropic 키' 'sk-ant-[0-9A-Za-z_-]{10,}'
sec 'AWS 액세스 키' 'AKIA[0-9A-Z]{16}'
sec 'Google API 키' 'AIza[0-9A-Za-z_-]{35}'
sec 'OpenAI 키' '(^|[^0-9A-Za-z])sk-(proj|svcacct|admin|None)-[0-9A-Za-z_-]{20,}'
sec 'OpenAI 키(구형)' '(^|[^0-9A-Za-z])sk-[0-9A-Za-z]{32,}'
sec 'Stripe 라이브 키' '[sr]k_live_[0-9A-Za-z]{20,}'
sec 'AWS 임시 키' 'ASIA[0-9A-Z]{16}'
sec 'npm 토큰' 'npm_[0-9A-Za-z]{36}'
sec 'Slack 웹훅 URL' 'hooks\.slack\.com/services/[A-Za-z0-9]+/[A-Za-z0-9]+/[0-9A-Za-z]+'
sec 'Atlassian API 토큰' 'ATATT3[0-9A-Za-z_=-]{20,}'

# ---- 금지어 목록 읽기 ----
DENY_FILE="${HEKA_PUSH_DENYLIST:-$HOME/.config/heka/push-denylist.txt}"
PATS="$TMP/deny.txt"
HAVE_DENY=0
HAVE_C=0

deny_missing_help() {
  {
    echo "pre-push: 금지어 목록 파일이 없다. 푸시를 막았다."
    echo "  경로: $DENY_FILE"
    echo "  만드는 방법: 한 줄에 확장 정규식 하나를 적은 텍스트 파일을 위 경로에 만든다."
    echo "    mkdir -p \"\$HOME/.config/heka\" && \$EDITOR \"\$HOME/.config/heka/push-denylist.txt\""
    echo "  다른 경로를 쓰려면 환경 변수 HEKA_PUSH_DENYLIST 에 파일 경로를 지정한다."
    echo "  금지어 검사만 건너뛰려면 HEKA_PUSH_DENYLIST_OPTIONAL=1 (비밀키 검사는 계속한다)."
  } >&2
}

if [ ! -e "$DENY_FILE" ] && [ ! -L "$DENY_FILE" ]; then
  # 상위 디렉터리를 들어갈 수 없어서 안 보이는 것이면 "없음" 이 아니라 읽기 실패다.
  DENY_DIR="$(dirname "$DENY_FILE")"
  if [ -d "$DENY_DIR" ] && [ ! -x "$DENY_DIR" ]; then
    fail_internal "금지어 목록이 든 디렉터리에 들어갈 수 없다(권한)"
  fi
  if [ "${HEKA_PUSH_DENYLIST_OPTIONAL:-}" = "1" ]; then
    echo "pre-push: 금지어 목록이 없어 금지어 검사를 건너뛴다(비밀키 검사는 한다)." >&2
  else
    deny_missing_help
    exit 1
  fi
else
  [ -f "$DENY_FILE" ] || fail_internal "금지어 목록 경로가 일반 파일이 아니다(끊긴 링크, 디렉터리 등)"
  [ -r "$DENY_FILE" ] || fail_internal "금지어 목록을 읽을 수 없다(권한)"
  # 읽기: CR 제거 -> 앞뒤 공백 제거, UTF-8 BOM 제거, 빈 줄·주석 제외. 단계마다 종료 코드를 본다.
  tr -d '\r' < "$DENY_FILE" > "$TMP/deny.raw" || fail_internal "금지어 목록을 읽지 못했다"
  LC_ALL=C awk '
    NR == 1 { sub(/^\357\273\277/, "") }
    { sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "") }
    $0 != "" && substr($0, 1, 1) != "#" { print }
  ' "$TMP/deny.raw" > "$PATS" || fail_internal "금지어 목록을 해석하지 못했다"
  if [ -s "$PATS" ]; then
    # 정규식이 올바른지 미리 확인한다(잘못된 줄이 있으면 grep 이 2 를 돌려준다)
    grep -Eif "$PATS" /dev/null
    rc=$?
    if [ "$rc" -gt 1 ]; then
      fail_internal "금지어 목록에 잘못된 정규식이 있다(패턴은 출력하지 않는다)"
    fi
    # 빈 문자열과 일치하는 패턴(예: x*)은 모든 줄에 걸리므로 목록 오류로 본다
    echo "" | grep -Eiqf "$PATS"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      fail_internal "금지어 목록에 빈 문자열과 일치하는 패턴이 있다(모든 줄에 걸린다. 패턴은 출력하지 않는다)"
    elif [ "$rc" -gt 1 ]; then
      fail_internal "금지어 목록을 대조하지 못했다"
    fi
    HAVE_DENY=1
    # 바이트 단위(C 로캘) 대조가 가능한지 본다. 맥의 grep 은 깨진 UTF-8 이 든 줄에서 일치를 놓치므로
    # 바이트 단위 대조를 먼저 하고, 다국어 정규식([가-힣] 등)은 사용자 로캘 대조가 맡는다.
    LC_ALL=C grep -Eif "$PATS" /dev/null
    if [ $? -le 1 ]; then HAVE_C=1; fi
  elif [ "${HEKA_PUSH_DENYLIST_OPTIONAL:-}" = "1" ]; then
    echo "pre-push: 금지어 목록에 유효한 패턴이 없어 금지어 검사를 건너뛴다(비밀키 검사는 한다)." >&2
  else
    {
      echo "pre-push: 금지어 목록에 유효한 패턴이 하나도 없다(빈 파일이거나 주석뿐). 푸시를 막았다."
      echo "  경로: $DENY_FILE"
      echo "  한 줄에 확장 정규식 하나를 적는다. 금지어 검사만 건너뛰려면 HEKA_PUSH_DENYLIST_OPTIONAL=1."
    } >&2
    exit 1
  fi
fi

# ---- 검사할 커밋·태그·ref 이름 모으기 ----
COMMITS="$TMP/commits.txt"
TAGS="$TMP/tags.txt"
REFS="$TMP/refs.txt"
: > "$COMMITS"
: > "$TAGS"
: > "$REFS"

add_revs() { # 인자: git rev-list 인자들
  git rev-list "$@" >> "$COMMITS" 2> "$TMP/err.txt" || {
    fail_internal "git rev-list $* 실패: $(head -c 200 "$TMP/err.txt")"
  }
}

case "$MODE" in
  all)
    revs=(--branches --tags --remotes)
    if git rev-parse --verify -q HEAD > /dev/null 2>&1; then
      revs=(HEAD "${revs[@]}")
    fi
    add_revs "${revs[@]}"
    git for-each-ref --format='%(refname)' refs/heads refs/tags refs/remotes >> "$REFS" ||
      fail_internal "git for-each-ref 실패"
    git for-each-ref --format='%(objecttype) %(objectname)' refs/tags > "$TMP/tagrefs.txt" ||
      fail_internal "git for-each-ref 실패"
    awk '$1 == "tag" { print $2 }' "$TMP/tagrefs.txt" >> "$TAGS" || fail_internal "태그 목록 정리 실패"
    ;;
  range)
    add_revs "$RANGE"
    ;;
  push)
    while read -r lref lsha rref rsha || [ -n "${lref:-}" ]; do
      if [ -z "${lsha:-}" ]; then
        lref=""
        continue
      fi
      if echo "$lsha" | grep -Eq "$ZERO"; then
        lref=""
        continue # 삭제 푸시
      fi
      printf '%s\n%s\n' "$lref" "${rref:-}" >> "$REFS"
      ltype="$(git cat-file -t "$lsha" 2> /dev/null)" || fail_internal "푸시할 개체 ${lsha}를 찾지 못했다"
      if [ "$ltype" = "tag" ]; then
        echo "$lsha" >> "$TAGS"
      fi
      if echo "${rsha:-}" | grep -Eq "$ZERO" || [ -z "${rsha:-}" ]; then
        add_revs "$lsha" --not "--remotes=$REMOTE"
      else
        if ! git cat-file -e "${rsha}^{commit}" 2> /dev/null; then
          {
            echo "pre-push: 원격의 옛 커밋(${rsha})이 로컬에 없어 푸시 범위를 구하지 못했다."
            echo "  강제 푸시이거나 원격에 다른 사람의 커밋이 올라온 경우다. git fetch 로 원격을 가져온 뒤 다시 푸시한다."
            echo "pre-push: 검사를 끝내지 못했으므로 푸시를 막았다."
          } >&2
          exit 1
        fi
        add_revs "$rsha..$lsha"
      fi
      lref=""
    done
    ;;
esac

# 중복 제거(순서 유지)
dedup() { # <파일>
  awk '!seen[$0]++' "$1" > "$1.uniq" && mv "$1.uniq" "$1" || fail_internal "목록 정리 실패"
}
dedup "$COMMITS"
dedup "$TAGS"
dedup "$REFS"
NCOMMITS="$(wc -l < "$COMMITS" | tr -d ' ')"

# ---- 검사 ----
FOUND=0

# 파일 이름이 금지어나 비밀키에 걸리는지(걸리면 출력하지 않는다)
name_sensitive() {
  if [ "$HAVE_DENY" -eq 1 ]; then
    if printf '\n%s\n' "$1" | grep -aEiqf "$PATS"; then return 0; fi
    if [ "$HAVE_C" -eq 1 ] && printf '\n%s\n' "$1" | LC_ALL=C grep -aEiqf "$PATS"; then return 0; fi
  fi
  printf '\n%s\n' "$1" | LC_ALL=C grep -aEqf "$SECRETS"
}

# report <대상> <종류> <위치> <줄 수> [<파일 이름 목록 파일>]
report() {
  local id="$1" kind="$2" where="$3" count="$4" nf="${5:-}" extra="" shown=0 total=0 name
  FOUND=$((FOUND + count))
  if [ -n "$nf" ] && [ -s "$nf" ]; then
    while IFS= read -r name; do
      total=$((total + 1))
      [ "$shown" -lt 5 ] || continue
      shown=$((shown + 1))
      if name_sensitive "$name"; then name="(이름이 걸려 가림)"; fi
      if [ "$shown" -eq 1 ]; then extra=", 파일: $name"; else extra="$extra, $name"; fi
    done < "$nf"
    if [ "$total" -gt "$shown" ]; then extra="$extra 외 $((total - shown))개"; fi
  fi
  printf 'pre-push: [%s] %s 걸림: %s, %s줄%s\n' "$id" "$kind" "$where" "$count" "$extra" >&2
}

# grep_nums C|L i|c <패턴 파일> <대상 파일> <결과 줄 번호 파일>: 걸린 줄 번호만 적는다(C=바이트 단위, L=사용자 로캘)
# 맥의 grep 은 파일이 UTF-16 BOM(FF FE, FE FF)으로 시작하면 내용을 UTF-16 으로 보고 일치를 놓친다.
# 그래서 맨 앞에 빈 줄을 하나 붙여 넣고, 나온 줄 번호에서 1 을 뺀다.
grep_nums() {
  local loc="$1" cs="$2" pf="$3" file="$4" out="$5" rcs opt=-anEf
  [ "$cs" = i ] && opt=-anEif
  if [ "$loc" = C ]; then
    { echo; cat "$file"; } | LC_ALL=C grep $opt "$pf" | awk -F: '{ print $1 - 1 }' > "$out"
    rcs=("${PIPESTATUS[@]}")
  else
    { echo; cat "$file"; } | grep $opt "$pf" | awk -F: '{ print $1 - 1 }' > "$out"
    rcs=("${PIPESTATUS[@]}")
  fi
  if [ "${rcs[0]}" -ne 0 ] || [ "${rcs[1]}" -gt 1 ] || [ "${rcs[2]}" -ne 0 ]; then
    fail_internal "대조 실패(${file##*/})"
  fi
}

# grep_hits d|s <대상 파일> <결과 줄 번호 파일>: 걸린 줄 번호를 적고, 걸린 것이 있으면 0, 없으면 1
grep_hits() {
  local mode="$1" file="$2" out="$3"
  if [ "$mode" = d ]; then
    grep_nums L i "$PATS" "$file" "$TMP/nums.L"
    : > "$TMP/nums.C"
    if [ "$HAVE_C" -eq 1 ]; then grep_nums C i "$PATS" "$file" "$TMP/nums.C"; fi
    sort -un "$TMP/nums.L" "$TMP/nums.C" > "$out" || fail_internal "대조 결과 정리 실패"
  else
    grep_nums C c "$SECRETS" "$file" "$out"
  fi
  [ -s "$out" ]
}

# hit_names <걸린 줄 번호 파일> <줄→파일 번호 파일> <파일 번호→이름 파일>: 이름 목록을 HITNAMES 에 적는다
HITNAMES="$TMP/hitnames.txt"
hit_names() {
  : > "$HITNAMES"
  [ -n "${2:-}" ] || return 0
  awk 'NR == FNR { w[$1] = 1; next } (FNR in w) { print }' "$1" "$2" | sort -un > "$TMP/fidx.txt" ||
    fail_internal "파일 이름 찾기 실패"
  awk -F'\t' 'NR == FNR { w[$1] = 1; next } ($1 in w) { print substr($0, index($0, "\t") + 1) }' \
    "$TMP/fidx.txt" "$3" > "$HITNAMES" || fail_internal "파일 이름 찾기 실패"
}

# scan_file <파일> <대상> <위치> [<줄→파일 번호 파일> <파일 번호→이름 파일>]
scan_file() {
  local file="$1" id="$2" where="$3" idx="${4:-}" names="${5:-}" nums="$TMP/nums.txt" re label i
  if [ "$HAVE_DENY" -eq 1 ] && grep_hits d "$file" "$nums"; then
    hit_names "$nums" "$idx" "$names"
    report "$id" "금지어" "$where" "$(wc -l < "$nums" | tr -d ' ')" "$HITNAMES"
  fi
  if grep_hits s "$file" "$nums"; then
    # 어떤 종류인지 패턴별로 다시 대조한다(걸렸을 때만)
    i=0
    while IFS= read -r re; do
      i=$((i + 1))
      printf '%s\n' "$re" > "$TMP/re.txt"
      grep_nums C c "$TMP/re.txt" "$file" "$nums"
      if [ -s "$nums" ]; then
        label="$(sed -n "${i}p" "$SECLABELS")"
        hit_names "$nums" "$idx" "$names"
        report "$id" "비밀키($label)" "$where" "$(wc -l < "$nums" | tr -d ' ')" "$HITNAMES"
      fi
    done < "$SECRETS"
  fi
}

# scan_diff <diff 파일> <대상> <위치>: 추가된 줄만 뽑아 파일 이름과 함께 대조한다
scan_diff() {
  : > "$TMP/added.txt"
  : > "$TMP/added.idx"
  : > "$TMP/added.names"
  LC_ALL=C awk -v ADDED="$TMP/added.txt" -v IDX="$TMP/added.idx" -v NAMES="$TMP/added.names" '
    /^diff --git / { hdr = 1; next }
    hdr && /^\+\+\+ / {
      n = substr($0, 5)
      sub(/\t$/, "", n)
      if (n == "/dev/null") { next }
      if (substr(n, 1, 1) == "\"") { n = substr(n, 2, length(n) - 2) }
      if (substr(n, 1, 2) == "b/") { n = substr(n, 3) }
      fi++
      print fi "\t" n > NAMES
      next
    }
    /^@@ /         { hdr = 0; next }
    hdr            { next }
    /^\+/          { print substr($0, 2) > ADDED; print fi > IDX }
  ' "$1" || fail_internal "diff 해석 실패($2)"
  scan_file "$TMP/added.txt" "$2" "$3" "$TMP/added.idx" "$TMP/added.names"
}

# 푸시되는 ref 이름
if [ -s "$REFS" ]; then
  scan_file "$REFS" "푸시 대상" "ref 이름"
fi

# 주석 태그(태그 메시지와 태거). 태그가 태그를 가리키면 끝까지 따라간다.
scan_tag() { # <sha>
  local sha="$1" depth=0 type short
  while [ "$depth" -lt 10 ]; do
    type="$(git cat-file -t "$sha" 2> /dev/null)" || fail_internal "git cat-file -t 실패"
    [ "$type" = "tag" ] || break
    short="$(git rev-parse --short "$sha")" || fail_internal "git rev-parse 실패"
    git cat-file tag "$sha" > "$TMP/tag.raw" || fail_internal "git cat-file tag 실패($short)"
    awk '
      BEGIN { h = 1 }
      h && /^$/ { h = 0; print; next }
      h && /^(object|type|tag) / { next }
      { print }
    ' "$TMP/tag.raw" > "$TMP/tag.txt" || fail_internal "태그 해석 실패($short)"
    scan_file "$TMP/tag.txt" "태그 $short" "태그 메시지·태거"
    sha="$(awk '/^object / { print $2; exit }' "$TMP/tag.raw")"
    [ -n "$sha" ] || fail_internal "태그가 가리키는 개체를 찾지 못했다($short)"
    depth=$((depth + 1))
  done
}
while IFS= read -r tsha; do
  [ -n "$tsha" ] || continue
  scan_tag "$tsha"
done < "$TAGS"

while IFS= read -r sha; do
  short="$(git rev-parse --short "$sha" 2> /dev/null)" || fail_internal "git rev-parse $sha 실패"

  # 작성자·커미터와 커밋 메시지(트레일러 포함)
  git log -1 --format='%an <%ae>%n%cn <%ce>' "$sha" > "$TMP/ident.txt" || fail_internal "git log 실패($short)"
  scan_file "$TMP/ident.txt" "$short" "작성자·커미터"
  git log -1 --format='%B' "$sha" > "$TMP/msg.txt" || fail_internal "git log 실패($short)"
  scan_file "$TMP/msg.txt" "$short" "커밋 메시지"

  # 병합 커밋에 들어 있는 태그 헤더(mergetag, 이어지는 줄은 공백으로 시작)
  git cat-file commit "$sha" > "$TMP/commit.raw" || fail_internal "git cat-file 실패($short)"
  awk '
    /^$/ { exit }
    /^mergetag / { m = 1; print substr($0, 10); next }
    m && /^ / { print substr($0, 2); next }
    { m = 0 }
  ' "$TMP/commit.raw" > "$TMP/mergetag.txt" || fail_internal "mergetag 해석 실패($short)"
  scan_file "$TMP/mergetag.txt" "$short" "병합 커밋의 태그"

  # 바뀐 파일 경로(-z: 이름에 줄바꿈이 있어도 안전하게 받고, 대조할 때 줄로 나눈다)
  git -c core.quotepath=off diff-tree -m -r -z --root --no-commit-id --name-only "$sha" > "$TMP/paths.raw" ||
    fail_internal "git diff-tree 실패($short)"
  LC_ALL=C tr '\0' '\n' < "$TMP/paths.raw" > "$TMP/paths.txt" || fail_internal "경로 정리 실패($short)"
  scan_file "$TMP/paths.txt" "$short" "파일 경로"

  # diff 에서 추가된 줄('+' 로 시작, 파일 헤더 제외). -a 로 바이너리 판정·.gitattributes 를 무시하고
  # 내용을 텍스트로 본다. NUL 은 공백으로 바꿔 줄이 끊기지 않게 한다. NUL 이 있었으면
  # NUL 을 지운 판도 한 번 더 대조한다(UTF-16 으로 저장된 글은 NUL 을 지워야 읽힌다).
  git -c core.quotepath=off diff-tree -m -p -a -U0 --root --no-commit-id --no-color --no-ext-diff --no-textconv "$sha" \
    > "$TMP/diff.raw" || fail_internal "git diff-tree -p 실패($short)"
  LC_ALL=C tr '\0' ' ' < "$TMP/diff.raw" > "$TMP/diff.txt" || fail_internal "diff 정리 실패($short)"
  scan_diff "$TMP/diff.txt" "$short" "추가된 줄"
  LC_ALL=C tr -d '\0' < "$TMP/diff.raw" > "$TMP/diff.nonul" || fail_internal "diff 정리 실패($short)"
  if ! cmp -s "$TMP/diff.raw" "$TMP/diff.nonul"; then
    scan_diff "$TMP/diff.nonul" "$short" "추가된 줄(NUL 제거 후)"
  fi
done < "$COMMITS"

if [ "$FOUND" -gt 0 ]; then
  echo "pre-push: 금지어·비밀키 ${FOUND}줄 발견(커밋 ${NCOMMITS}개 검사). 푸시를 막았다." >&2
  echo "  걸린 줄의 원문은 출력하지 않는다. 위 커밋·위치를 직접 확인해 고친다." >&2
  exit 1
fi

if [ "$NCOMMITS" -eq 0 ]; then
  echo "pre-push: 검사할 커밋 없음"
  exit 0
fi

echo "pre-push: 커밋 ${NCOMMITS}개 검사, 문제 없음"
exit 0
